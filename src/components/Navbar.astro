---
import Button from './ui/button.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${baseUrl}/logo.svg`;
---

<header class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md border-b border-slate-100 shadow-sm transition-all duration-300">
  <div class="h-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    <!-- Brand / Logo (Centered vertically with text) -->
    <a class="flex items-center gap-3 group" data-path="beranda" href="#">
      <img
        src={logoSrc}
        alt="Logo Donasi Barang Purwakarta"
        class="h-10 sm:h-12 w-auto object-contain shrink-0 group-hover:scale-105 transition-transform duration-200"
      />
      <span class="text-lg sm:text-xl font-extrabold tracking-tight text-slate-900 group-hover:text-orange-600 transition-colors">
        Donasi Barang Purwakarta
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      <a class="text-sm font-semibold text-slate-600 hover:text-orange-600 transition-colors py-1" data-path="tentang" href="#tentang">
        Tentang
      </a>
      <a class="text-sm font-semibold text-slate-600 hover:text-orange-600 transition-colors py-1" data-path="alur" href="#alur">
        Alur
      </a>
      <a class="text-sm font-semibold text-slate-600 hover:text-orange-600 transition-colors py-1" data-path="kriteria" href="#kriteria">
        Kriteria
      </a>
      <a class="text-sm font-semibold text-slate-600 hover:text-orange-600 transition-colors py-1" data-path="galeri" href="#galeri">
        Galeri
      </a>
      <a class="text-sm font-semibold text-slate-600 hover:text-orange-600 transition-colors py-1" data-path="dokumentasi" href="#dokumentasi">
        Dokumentasi
      </a>
    </nav>

    <!-- Right Action Items -->
    <div class="flex items-center gap-3">
      <Button
        href="https://wa.me/6285117305487"
        target="_blank"
        rel="noopener noreferrer"
        variant="orange"
        size="default"
        class="hidden sm:inline-flex items-center justify-center bg-orange-500 text-white hover:bg-orange-600 rounded-full px-6 py-2 text-sm font-bold transition-all shadow-md hover:shadow-lg"
        data-path="hubungi-admin"
      >
        <span>Hubungi Admin</span>
      </Button>

      <div class="w-8 h-8 rounded-full bg-[#9d4300] text-white flex items-center justify-center shadow-sm">
        <span class="material-symbols-outlined text-[18px]">person</span>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        class="md:hidden w-9 h-9 rounded-xl bg-slate-100 flex items-center justify-center text-slate-700 hover:bg-slate-200 transition-colors"
      >
        <span class="material-symbols-outlined text-[22px]" id="menu-icon">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white/95 backdrop-blur-lg px-6 py-5 space-y-3 shadow-xl">
    <nav class="flex flex-col space-y-2">
      <a href="#tentang" class="mobile-nav-link text-base font-semibold text-slate-700 hover:text-orange-600 py-1 transition-colors">
        Tentang
      </a>
      <a href="#alur" class="mobile-nav-link text-base font-semibold text-slate-700 hover:text-orange-600 py-1 transition-colors">
        Alur
      </a>
      <a href="#kriteria" class="mobile-nav-link text-base font-semibold text-slate-700 hover:text-orange-600 py-1 transition-colors">
        Kriteria
      </a>
      <a href="#galeri" class="mobile-nav-link text-base font-semibold text-slate-700 hover:text-orange-600 py-1 transition-colors">
        Galeri
      </a>
      <a href="#dokumentasi" class="mobile-nav-link text-base font-semibold text-slate-700 hover:text-orange-600 py-1 transition-colors">
        Dokumentasi
      </a>
    </nav>
    <div class="pt-3 border-t border-slate-100">
      <Button
        href="https://wa.me/6285117305487"
        target="_blank"
        rel="noopener noreferrer"
        variant="orange"
        size="default"
        class="w-full justify-center rounded-xl font-bold"
      >
        <span>Hubungi Admin WhatsApp</span>
      </Button>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  menuBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    if (isHidden) {
      mobileMenu?.classList.remove('hidden');
      if (menuIcon) menuIcon.textContent = 'close';
    } else {
      mobileMenu?.classList.add('hidden');
      if (menuIcon) menuIcon.textContent = 'menu';
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      if (menuIcon) menuIcon.textContent = 'menu';
    });
  });
</script>
