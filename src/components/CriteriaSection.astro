---

<!-- 4. Kriteria Barang (Highly Visual Image Cards) -->
<section id="kriteria" class="bg-slate-50/80 py-24 lg:py-32 w-full border-y border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 lg:mb-20 reveal-on-scroll">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-800 mb-3 tracking-tight">Barang yang Dapat Didonasikan</h2>
      <p class="text-base sm:text-lg text-slate-500 leading-relaxed">Pastikan barang yang Anda donasikan dalam kondisi masih layak pakai.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 lg:gap-8">
      {items.map((item, index) => (
        <div class="reveal-on-scroll" style={`transition-delay: ${(index % 4) * 100}ms`}>
          <Card hoverEffect class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden group border border-slate-100 h-full flex flex-col">
            <div class="overflow-hidden h-44 sm:h-48 w-full bg-slate-100">
              <img
                class="h-full w-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                src={item.image}
                alt={item.alt}
                loading="lazy"
              />
            </div>
            <div class="p-4 sm:p-5 text-center bg-white z-10 relative flex-1 flex items-center justify-center">
              <span class="font-bold text-slate-800 text-sm sm:text-base group-hover:text-orange-600 transition-colors">{item.title}</span>
            </div>
          </Card>
        </div>
      ))}
    </div>
  </div>
</section>
