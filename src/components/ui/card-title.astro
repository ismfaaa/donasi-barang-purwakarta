---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../../lib/utils';

export interface Props extends HTMLAttributes<'h3'> {
  class?: string;
}

const { class: className, ...props } = Astro.props;
---

<h3 class={cn('text-2xl font-bold leading-none tracking-tight text-slate-900', className)} {...props}>
  <slot />
</h3>

