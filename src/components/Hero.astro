---
import Button from './ui/button.astro';
---

<!-- 2. Hero Section (Vibrant & Overlapping) -->
<section class="relative pt-16 pb-36 lg:pt-24 lg:pb-44 bg-gradient-to-br from-green-50/50 via-slate-50 to-orange-50/30 overflow-hidden w-full">
  <!-- Ambient Glow -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl pointer-events-none animate-float-slow"></div>
  <div class="absolute top-1/2 -right-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none animate-float"></div>

  <div class="grid lg:grid-cols-2 gap-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 items-center relative z-10">
    <!-- Left Column -->
    <div class="flex flex-col items-start">
      <div class="inline-flex items-center gap-2 bg-green-100 text-emerald-800 px-4 py-1.5 rounded-full text-sm font-bold mb-6 shadow-sm animate-float">
        <span>📦</span>
        <span>Barang numpuk jadi berkah, siap jemput sampai rumah.</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-tight mb-6 tracking-tight">
        Ubah Barang Tak Terpakai Menjadi <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-600 via-amber-600 to-orange-500">Amal Jariyah</span>
      </h1>

      <p class="text-lg text-slate-600 mb-8 max-w-xl leading-relaxed">
        Kami menerima donasi barang layak pakai untuk dilelang. Seluruh hasil penjualan didedikasikan untuk dana wakaf Yayasan.
      </p>

      <div class="flex flex-col items-start gap-2">
        <Button
          href="https://wa.me/6285117305487"
          target="_blank"
          rel="noopener noreferrer"
          variant="orange"
          size="xl"
          class="bg-orange-500 hover:bg-orange-600 text-white text-lg px-8 py-4 rounded-2xl shadow-lg hover:shadow-orange-500/30 hover:-translate-y-1 transition-all font-bold inline-flex items-center gap-3"
        >
          <span class="material-symbols-outlined text-[24px]">favorite</span>
          <span>Donasi Sekarang</span>
        </Button>

        <span class="text-sm text-slate-500 mt-3 block font-medium">
          * Layanan jemput gratis khusus area Purwakarta
        </span>
      </div>
    </div>

    <!-- Right Column -->
    <div class="relative w-full">
      <div class="absolute inset-0 bg-orange-500/15 rounded-3xl blur-xl transform translate-y-4 pointer-events-none"></div>
      <div class="relative z-10 rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-white group">
        <img
          class="rounded-3xl shadow-2xl relative z-10 w-full h-[400px] sm:h-[450px] object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuDzIvxH7k703H3amF_s0amMN4KSuptysLC8bRaxF3MdElxenomOkGtGgQfQ3RMCzamnCXnKuVwyenpOSKJvmG9GF67D1I8SQNb3ydAY402BmIJikxextlJ3VLYEXVwutxTaegD0JSXM9AfN7GIJmojqXtDx3TsUSWZFfXN_EtVSqEuIKE1BCGuwV3W0FCg5ppn5xzGoQ8oG8pDxEMhg6Ew94Nd30cnQJhEra8ypKw"
          alt="A clean, vibrant high-quality photo of a donation cardboard box filled with folded clothes, books, and neat gadgets on a bright clean studio background with natural warm lighting, vivid orange and emerald green accent elements."
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

