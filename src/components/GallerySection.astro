<!-- 6. Galeri Barang Donasi (Polaroid Style Masonry) -->
<section id="galeri" class="bg-slate-50/80 py-24 lg:py-32 overflow-hidden w-full border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-800 mb-16 text-center tracking-tight reveal-on-scroll">
      Galeri Barang Donasi
    </h2>

    <div class="flex flex-wrap justify-center gap-8 max-w-6xl mx-auto px-4 py-8">
      {polaroids.map((item, index) => (
        <div class="reveal-on-scroll" style={`transition-delay: ${index * 80}ms`}>
          <div class={`bg-white p-4 shadow-xl hover:shadow-2xl rounded-sm pb-16 w-64 transform ${item.rotation} ${item.hoverRotate} transition-all duration-300 hover:z-50 hover:scale-110 cursor-pointer group`}>
            <img
              class="square h-52 w-full object-cover rounded-sm group-hover:scale-105 transition-transform duration-500 ease-out"
              src={item.image}
              alt={item.alt}
              loading="lazy"
            />
            <div class="font-medium text-slate-700 text-lg mt-4 text-center italic font-serif group-hover:text-orange-600 transition-colors">
              {item.title}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA Bottom -->
    <div class="mt-16 text-center flex justify-center px-4 reveal-on-scroll">
      <Button
        href="https://wa.me/6285117305487"
        target="_blank"
        rel="noopener noreferrer"
        variant="orange"
        size="xl"
        class="bg-orange-500 text-white font-bold px-8 py-4 rounded-xl shadow-lg hover:bg-orange-600 transition-colors inline-flex items-center gap-3 text-base md:text-lg"
      >
        <span class="material-symbols-outlined text-[24px]">shopping_bag</span>
        <span>Tertarik membeli? Hubungi Admin WhatsApp (Mulai dari Rp 5.000)</span>
      </Button>
    </div>
  </div>
</section>
