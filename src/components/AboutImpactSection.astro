---
import Card from './ui/card.astro';
---

<!-- 3. Tentang & Impact Stats (Overlapping the Hero) -->
<section id="tentang" class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-24 mb-24 lg:mb-32 w-full">
  <div class="grid lg:grid-cols-12 gap-8 items-stretch">
    
    <!-- Left (Tentang Program - spans 7 cols) -->
    <div class="lg:col-span-7 reveal-on-scroll">
      <Card class="bg-white rounded-3xl p-8 lg:p-10 shadow-xl border border-slate-100 h-full relative overflow-hidden flex flex-col justify-center">
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-green-100/60 rounded-full blur-2xl pointer-events-none"></div>
        <div class="relative z-10">
          <span class="text-emerald-700 font-bold text-sm uppercase tracking-wider mb-2 block">Profil Inisiatif</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-800 mb-4 tracking-tight">Tentang Donasi Barang</h2>
          <p class="text-slate-600 leading-relaxed text-base sm:text-lg">
            Program sosial yang digagas oleh Wakaf Senyum Mandiri di bawah naungan Yayasan Senyum Mandiri. Program ini bertujuan untuk mengonversi barang layak pakai menjadi dana produktif. Saat ini, seluruh dana difokuskan untuk mendorong program wakaf pembangunan kelas tahfidz, dan akan terus berkembang menyesuaikan kebutuhan kemaslahatan umat.
          </p>
        </div>
      </Card>
    </div>

    <!-- Right (Impact Stats - spans 5 cols) -->
    <div class="lg:col-span-5 flex flex-col gap-4 justify-between reveal-on-scroll delay-150">
      
      <!-- Stat Card 1 -->
      <Card hoverEffect class="bg-white rounded-2xl p-6 shadow-md border-l-4 border-emerald-600 flex items-center gap-5 group">
        <div class="p-4 bg-green-50 text-emerald-700 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-slate-800">50+ Donatur</div>
          <div class="text-sm text-slate-500 font-medium">Warga &amp; Instansi</div>
        </div>
      </Card>

      <!-- Stat Card 2 -->
      <Card hoverEffect class="bg-white rounded-2xl p-6 shadow-md border-l-4 border-emerald-600 flex items-center gap-5 group">
        <div class="p-4 bg-green-50 text-emerald-700 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-slate-800">120+ Barang Diterima</div>
          <div class="text-sm text-slate-500 font-medium">Berbagai jenis barang</div>
        </div>
      </Card>

      <!-- Stat Card 3 -->
      <Card hoverEffect class="bg-white rounded-2xl p-6 shadow-md border-l-4 border-orange-500 flex items-center gap-5 group">
        <div class="p-4 bg-orange-50 text-orange-600 rounded-xl flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-slate-800">Rp 100.000+ Dana Tersalurkan</div>
          <div class="text-sm text-slate-500 font-medium">Untuk wakaf kelas tahfidz</div>
        </div>
      </Card>

    </div>

  </div>
</section>
