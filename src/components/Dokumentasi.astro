---
import fs from 'node:fs';
import path from 'node:path';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch/map photos dynamically from public/images
const imagesDir = path.join(process.cwd(), 'public', 'images');
let imageFiles: string[] = [];

try {
  if (fs.existsSync(imagesDir)) {
    imageFiles = fs
      .readdirSync(imagesDir)
      .filter((file) => /\.(jpe?g|png|webp|svg)$/i.test(file))
      .sort();
  }
} catch (error) {
  console.error('Error reading /images directory:', error);
}

// Fallback in case of filesystem issues
if (imageFiles.length === 0) {
  imageFiles = [
    'Tahap 1 Image 2026-10-17 at 15.17.18.jpeg',
    'Tahap 1 Image 2026-10-17 at 15.50.13.jpeg',
    'Tahap 2 Image 2026-11-07 at 10.17.33.jpeg',
    'Tahap 2 Image 2026-11-07 at 10.35.34.jpeg',
    'Tahap 2 Image 2026-11-07 at 10.57.43.jpeg',
    'Tahap 2 Image 2026-11-07 at 11.19.08.jpeg',
    'Tahap 2 Image 2026-11-07 at 11.54.17.jpeg',
    'Tahap 2 Image 2026-11-07 at 13.20.56.jpeg',
    'Tahap 2 Image 2026-11-07 at 13.20.57 2.jpeg',
    'Tahap 2 Image 2026-11-07 at 13.20.57 3.jpeg',
    'Tahap 2 Image 2026-11-07 at 13.20.57.jpeg',
  ];
}

const photos = imageFiles.map((filename, index) => ({
  src: `${baseUrl}/images/${encodeURIComponent(filename)}`,
  alt: `Dokumentasi Penjemputan Barang Donasi Purwakarta ${index + 1}`,
}));

// Duplicate photos for seamless infinite marquee loop
const marqueePhotos = [...photos, ...photos];
---

<!-- 7. Dokumentasi Penjemputan (Infinite Marquee Auto-scroll) -->
<section id="dokumentasi" class="bg-white py-24 lg:py-32 w-full overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 sm:mb-16">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-800 mb-3 tracking-tight">
        Dokumentasi Penjemputan
      </h2>
      <p class="text-base sm:text-lg text-slate-500 leading-relaxed">
        Dokumentasi nyata kegiatan penjemputan barang donasi dari para warga di wilayah Purwakarta.
      </p>
    </div>
  </div>

  <!-- Infinite Marquee Slider with Pause on Hover -->
  <div class="relative w-full overflow-hidden marquee-container group py-4">
    <!-- Gradient Fade Edges -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-16 sm:w-28 bg-gradient-to-r from-white to-transparent z-10"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-16 sm:w-28 bg-gradient-to-l from-white to-transparent z-10"></div>

    <!-- Scrolling Track with Continuous Loop -->
    <div class="flex gap-6 w-max animate-marquee hover:[animation-play-state:paused] group-hover:[animation-play-state:paused]">
      {marqueePhotos.map((photo, index) => (
        <div class="flex-none w-80 sm:w-96 aspect-video bg-slate-200 rounded-2xl shadow-md overflow-hidden border border-slate-100 group/card">
          <img
            src={photo.src}
            alt={photo.alt}
            loading={index < 4 ? 'eager' : 'lazy'}
            class="w-full h-full object-cover rounded-2xl transition-transform duration-500 group-hover/card:scale-105"
          />
        </div>
      ))}
    </div>
  </div>
</section>
