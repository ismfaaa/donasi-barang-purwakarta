---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Tentang from '../components/Tentang.astro';
import Kriteria from '../components/Kriteria.astro';
import Alur from '../components/Alur.astro';
import Galeri from '../components/Galeri.astro';
import Dokumentasi from '../components/Dokumentasi.astro';
---

<Layout
  title="Donasi Barang Purwakarta - Ubah Barang Tak Terpakai Menjadi Amal Jariyah"
  description="Layanan jemput donasi barang layak pakai gratis se-Purwakarta. Seluruh hasil lelang dialokasikan 100% untuk wakaf pembangunan kelas tahfidz Quran."
>
  <!-- 2. Hero Section -->
  <Hero />

  <!-- 3. Tentang & Impact Stats (Overlapping the Hero) -->
  <Tentang />

  <!-- 4. Kriteria Barang -->
  <Kriteria />

  <!-- 5. Alur Program (Redesigned Rich Horizontal Timeline) -->
  <Alur />

  <!-- 6. Galeri Barang Donasi (Polaroid Style) -->
  <Galeri />

  <!-- 7. Dokumentasi Penjemputan -->
  <Dokumentasi />
</Layout>
